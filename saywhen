#  Expresiones regulares (se aplican sobre el texto en minúsculas y sin acentos)
# ════════════════════════════════════════════════════════════════════════════

_SEP = r"(?:\s*,\s*(?:y\s+|e\s+|and\s+)?|\s+(?:y|e|and)\s+|\s*&\s*)"

# — Recurrencia —
RE_WEEKDAYS = (r"(?<![a-z])(?:todos\s+los\s+dias\s+laborables|dias\s+laborables|"
               r"de\s+lunes\s+a\s+viernes|every\s+weekday|on\s+weekdays|weekdays|entre\s+semana)(?![a-z])")
RE_REC_WD = [
    rf"(?<![a-z])(?:todos\s+los|todas\s+las|cada|every|each)\s+(?P<other>(?:otro|other)\s+)?"
    rf"(?P<days>{WD_ANY}(?:{_SEP}{WD_ANY})*)(?![a-z])",
    rf"(?<![a-z])los\s+(?P<days>{WD_ANY}(?:{_SEP}{WD_ANY})*)(?![a-z])",
    rf"(?<![a-z])(?:on\s+)?(?P<days>{WD_PL_EN}(?:{_SEP}{WD_PL_EN})*)(?![a-z])",
]
RE_REC_UNIT = (
    r"(?<![a-z])(?:(?:todos\s+los|todas\s+las|cada|every|each)\s+"
    r"(?:(?P<n>\d+|dos|tres|cuatro|cinco|two|three|four|five|other|otro|otra)\s+)?"
    r"(?P<unit>dias?|semanas?|meses|mes|anos?|days?|weeks?|months?|years?)"
    r"|(?P<adv>diariamente|diario|semanalmente|semanal|mensualmente|mensual|"
    r"anualmente|anual|daily|weekly|monthly|yearly|annually|everyday))(?![a-z])"
)
_UNIT_FREQ = {"dia": "DAILY", "day": "DAILY", "semana": "WEEKLY", "week": "WEEKLY",
              "mes": "MONTHLY", "month": "MONTHLY", "ano": "YEARLY", "year": "YEARLY"}
_ADV_FREQ = {"diariamente": "DAILY", "diario": "DAILY", "daily": "DAILY", "everyday": "DAILY",
             "semanalmente": "WEEKLY", "semanal": "WEEKLY", "weekly": "WEEKLY",
             "mensualmente": "MONTHLY", "mensual": "MONTHLY", "monthly": "MONTHLY",
             "anualmente": "YEARLY", "anual": "YEARLY", "yearly": "YEARLY", "annually": "YEARLY"}


# — Duración —
def _dur_re(prefixed: bool) -> str:
    hu = r"(?:horas?|hours?|hrs?" + ("|h" if prefixed else "") + r")(?![a-z])"
    mu = r"(?:minutos?|minutes?|mins?" + ("|m" if prefixed else "") + r")(?![a-z])"
    body = (
        r"(?P<half>media\s+hora|half\s+an?\s+hour|half[- ]hour)"
        rf"|(?P<h>{NUM})\s*{hu}(?:\s*(?:y\s+media|and\s+a\s+half)(?P<hh>)"
        rf"|\s*(?:y|and)?\s*(?P<hm>\d{{1,2}})\s*{mu}|(?<=h)(?P<hg>\d{{2}})(?!\d))?"
        rf"|(?P<m>{NUM})\s*{mu}"
    )
    pre = r"(?:por|durante|for|lasting)\s+(?:(?:unos|about|aprox\.?)\s+)?" if prefixed else ""
    return rf"(?<![a-z0-9]){pre}(?:{body})"


RE_DUR_PREFIXED = _dur_re(True)
RE_DUR_BARE = _dur_re(False)

# — Hora —
_T = r"(?P<{h}>\d{{1,2}})(?::(?P<{m}>\d{{2}}))?(?:\s*(?P<{a}>am|pm))?"
RE_T_RANGE = (
    r"(?<![a-z0-9:.])(?:(?P<pre>de|from|entre|between|a\s+las?|at)\s+)?(?:las?\s+)?"
    + _T.format(h="h1", m="m1", a="a1")
    + r"\s*(?P<conn>-|–|—|a|al|hasta|to|until|y|and)\s*(?:las?\s+)?"
    + _T.format(h="h2", m="m2", a="a2") + r"(?![\d:])"
)
_HSUF = r"(?:\s*(?:h|hs|hrs|horas?)(?![a-z]))?"
_PARTSUF = rf"(?:\s+(?:de\s+la|por\s+la|in\s+the)\s+(?P<part>{PART})(?![a-z]))?"
RE_T1 = (r"(?<![a-z0-9])(?:a\s+las?|a\s+eso\s+de|at|@|around|about|sobre\s+las?|hacia\s+las?)\s*"
         r"(?P<h>\d{1,2})(?:[:.h](?P<m>\d{2}))?(?:\s*(?P<a>am|pm))?" + _HSUF + _PARTSUF)
RE_T2 = (r"(?<![a-z0-9:.])(?P<h>\d{1,2}):(?P<m>\d{2})(?:\s*(?P<a>am|pm))?(?![a-z0-9:])" + _HSUF + _PARTSUF)
RE_T3 = r"(?<![a-z0-9:.])(?P<h>\d{1,2})\s*(?P<a>am|pm)(?![a-z])"
RE_T4 = r"(?<![a-z])(?P<w>mediodia|midday|noon|medianoche|midnight)(?![a-z])"

# — Fecha —
RE_ISO = r"(?<![\d/.-])(?P<y>\d{4})-(?P<mo>\d{1,2})-(?P<d>\d{1,2})(?!\d)"
RE_D1 = (rf"(?<![a-z0-9])(?:(?:el|on|the|este)\s+)?(?:dia\s+)?(?P<d>\d{{1,2}})(?:st|nd|rd|th|ro|o)?\s+"
         rf"(?:de\s+|of\s+)?(?P<mon>{MON})\.?(?![a-z])(?:\s+(?:del?\s+|,\s*)?(?P<y>\d{{4}}))?")
RE_D2 = (rf"(?<![a-z0-9])(?P<mon>{MON})\.?\s+(?:the\s+)?(?P<d>\d{{1,2}})(?:st|nd|rd|th)?(?![\d:a-z])"
         rf"(?:,?\s+(?P<y>\d{{4}}))?")
RE_NUM_Y4 = r"(?<![\d/.:-])(?P<a>\d{1,2})-(?P<b>\d{1,2})-(?P<y>\d{4})(?![\d:])"
RE_NUM = r"(?<![\d/.:-])(?P<a>\d{1,2})[/.](?P<b>\d{1,2})(?:[/.](?P<y>\d{4}|\d{2}))?(?![\d:])"
RE_AFTER_TOMORROW = r"(?<![a-z])(?:pasado\s+manana|day\s+after\s+tomorrow)(?![a-z])"
RE_TOMORROW = r"(?<![a-z])(?:manana|tomorrow)(?![a-z])"
RE_TODAY = r"(?<![a-z])(?:hoy|today|tonight|esta\s+noche|esta\s+tarde|this\s+evening)(?![a-z])"
RE_IN_N = (rf"(?<![a-z])(?:en|dentro\s+de|in)\s+(?P<n>{NUM})\s+"
           r"(?P<u>dias?|semanas?|meses|mes|days?|weeks?|months?)(?![a-z])")
RE_NEXT_WEEK = r"(?<![a-z])(?:la\s+)?(?:proxima\s+semana|semana\s+que\s+viene|next\s+week)(?![a-z])"
RE_WEEKDAY = (rf"(?<![a-z])(?P<pre>(?:(?:el|on|the|este|this)\s+)?(?:(?:proximo|next)\s+)?)"
              rf"(?P<wd>{WD_SING})(?![a-z])")


