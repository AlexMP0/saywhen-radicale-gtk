def ask_phrase(cfg: Config) -> str:
    try:
        from prompt_toolkit import PromptSession
    except ImportError:
        return input("[⌐■w■] > ")
    session = PromptSession()

    def toolbar():
        t = session.default_buffer.text
        if not t.strip():
            return " Ej.: Gimnasio todos los martes y viernes a las 9"
        try:
            return " " + one_line(parse(t, cfg.now(), cfg.date_order, cfg.default_minutes, cfg.pm_guess))
        except ParseError as e:
            return f" ⚠ {e}"

    return session.prompt("[⌐■w■] > ", bottom_toolbar=toolbar)


def selftest() -> int:
    tz = ZoneInfo("Europe/Madrid")
    now = dt.datetime(2026, 11, 12, 10, 0, tzinfo=tz)      # jueves

    def summ(e: Event) -> str:
        if e.all_day:
            return f"{e.title}|{e.start}|allday|{e.rrule}"
        return f"{e.title}|{e.start:%Y-%m-%d %H:%M}|{e.end:%H:%M}|{e.rrule}"

    cases = [
        ("Gym todos los martes y viernes a las 9", "Gym|2026-11-13 09:00|10:00|FREQ=WEEKLY;BYDAY=TU,FR"),
        ("Movie tomorrow at 11 for an hour and a half", "Movie|2026-11-13 11:00|12:30|None"),
        ("Cine mañana a las 11 una hora y media", "Cine|2026-11-13 11:00|12:30|None"),
        ("Dentist june 3 at 12:30", "Dentist|2027-06-03 12:30|13:30|None"),
        ("Dentista 3 de junio a las 12:30", "Dentista|2027-06-03 12:30|13:30|None"),
        ("Cena con Ana el viernes a las 9 de la noche", "Cena con Ana|2026-11-13 21:00|22:00|None"),
        ("Reunión de 3 a 5 el lunes", "Reunión|2026-11-16 15:00|17:00|None"),
        ("Médico 15/12 10:30", "Médico|2026-12-15 10:30|11:30|None"),
        ("Revisión cada 2 semanas el lunes a las 10", "Revisión|2026-11-16 10:00|11:00|FREQ=WEEKLY;INTERVAL=2"),
        ("Vitaminas todos los días a las 8", "Vitaminas|2026-11-13 08:00|09:00|FREQ=DAILY"),
        ("Cumpleaños de Marta 3 de mayo", "Cumpleaños de Marta|2027-05-03|allday|None"),
        ("Llamar a mamá hoy a las 18:30", "Llamar a mamá|2026-11-12 18:30|19:30|None"),
        ("Call Bob in 2 days at 3pm", "Call Bob|2026-11-14 15:00|16:00|None"),
        ("Yoga 7pm every weekday", "Yoga|2026-11-12 19:00|20:00|FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR"),
        ("Dentista 2026-12-01 a las 16", "Dentista|2026-12-01 16:00|17:00|None"),
        ("Examen el próximo martes de 9 a 11", "Examen|2026-11-17 09:00|11:00|None"),
        ("Concierto 20 de diciembre a las 21:00 por 3 horas", "Concierto|2026-12-20 21:00|00:00|None"),
        ("Lunch at 1", "Lunch|2026-11-12 13:00|14:00|None"),
        ("Reunión a las 9 de la mañana", "Reunión|2026-11-13 09:00|10:00|None"),
        ("Clase los lunes y miércoles a las 18", "Clase|2026-11-16 18:00|19:00|FREQ=WEEKLY;BYDAY=MO,WE"),
        ("Gimnasio mañana por 45 min a las 7", "Gimnasio|2026-11-13 07:00|07:45|None"),
        ("Standup every monday at 9:15am for 15 minutes", "Standup|2026-11-16 09:15|09:30|FREQ=WEEKLY;BYDAY=MO"),
    ]
    bad = 0
    for phrase, want in cases:
        try:
            got = summ(parse(phrase, now))
        except ParseError as e:
            got = f"ERROR {e}"
        ok = got == want
        bad += not ok
        print(("✓ " if ok else "✗ ") + phrase + ("" if ok else f"\n    esperado: {want}\n    obtenido: {got}"))
    try:
        parse("hola qué tal", now)
        print("✗ «hola qué tal» debería fallar")
        bad += 1
    except ParseError:
        print("✓ «hola qué tal» → error")
    print(f"\n{'Todo OK' if not bad else str(bad) + ' fallo(s)'}")
    return 1 if bad else 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="saywhen", description="Una frase → evento en tu Radicale.")
    ap.add_argument("phrase", nargs="*", help="p. ej.: Dentista 3 de junio a las 12:30")
    ap.add_argument("-y", "--yes", action="store_true", help="no pedir confirmación")
    ap.add_argument("-n", "--dry-run", action="store_true", help="solo mostrar lo que entendió")
    ap.add_argument("--ics", action="store_true", help="imprimir el .ics generado")
    ap.add_argument("--init", action="store_true", help="crear/actualizar la configuración")
    ap.add_argument("--check", action="store_true", help="probar la conexión con Radicale")
    ap.add_argument("--config", help="ruta alternativa del config.ini")
    ap.add_argument("--selftest", action="store_true", help="ejecutar pruebas del parser")
    args = ap.parse_args(argv)

    if args.selftest:
        return selftest()

    path = config_path(args.config)
    if args.init:
        run_init(path)
        return 0
    cfg = load_config(path)
    if args.check:
        return 0 if check_connection(cfg) else 1

    try:
        if args.phrase:
            phrase = " ".join(args.phrase)
        elif not sys.stdin.isatty():
            phrase = sys.stdin.read()
        else:
            phrase = ask_phrase(cfg)
    except (KeyboardInterrupt, EOFError):
        print()
        return 130

    now = cfg.now()
    try:
        ev = parse(phrase, now, cfg.date_order, cfg.default_minutes, cfg.pm_guess)
    except ParseError as e:
        print(f"No pude entender la frase: {e}", file=sys.stderr)
        return 2

    print(preview(ev, cfg))
    ics = to_ics(ev, cfg.tzname, now)
    if args.ics:
        print("\n" + ics.replace("\r\n", "\n"))
    if args.dry_run:
        return 0

    _need_server(cfg)
    if not args.yes:
        try:
            ans = input("\n¿Guardar? [S/n] ").strip().lower()
        except (KeyboardInterrupt, EOFError):
            print()
            return 130
        if ans not in ("", "s", "si", "sí", "y", "yes"):
            print("Cancelado.")
            return 1
    put_event(cfg, ev, ics)
    print("[■w■]✓ Evento guardado en Radicale.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
