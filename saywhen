@dataclass
class Event:
    title: str
    start: object          # datetime o date
    end: object
    all_day: bool
    rrule: Optional[str] = None
    recur_text: Optional[str] = None
    uid: str = field(default_factory=lambda: f"{uuid.uuid4()}@saywhen")


class Scratch:
    """Texto de trabajo: cada coincidencia se 'consume' y lo que sobra es el título."""

    def __init__(self, text: str):
        self.orig = text
        self.s = norm(text)
        self.removed = [False] * len(text)

    def take(self, pattern: str, check=None):
        for m in re.finditer(pattern, self.s):
            if check is not None and not check(m):
                continue
            a, b = m.span()
            self.s = self.s[:a] + " " * (b - a) + self.s[b:]
            for i in range(a, b):
                self.removed[i] = True
            return m
        return None

    def title(self) -> str:
        chars = [" " if r else c for c, r in zip(self.orig, self.removed)]
        words = "".join(chars).split()

        def junk(w, trailing):
            k = norm(w).strip(",.;:-–—()[]\"'")
            return k == "" or k in STOP or (trailing and k in STOP_TRAIL)

        while words and junk(words[0], False):
            words.pop(0)
        while words and junk(words[-1], True):
            words.pop()
        t = " ".join(words).strip(" ,;:-–—")
        return (t[0].upper() + t[1:]) if t else ""


def add_months(d: dt.date, n: int) -> dt.date:
    y, m = divmod(d.month - 1 + n, 12)
    y += d.year
    m += 1
    return d.replace(year=y, month=m, day=min(d.day, calendar.monthrange(y, m)[1]))


def mk_date(y, mo: int, d: int, today: dt.date) -> Optional[dt.date]:
    try:
        if y is None:
            c = dt.date(today.year, mo, d)
            return c if c >= today else dt.date(today.year + 1, mo, d)
        y = int(y)
        return dt.date(y + 2000 if y < 100 else y, mo, d)
    except ValueError:
        return None


def to_hm(h, m, ap, part, pm_guess) -> Optional[tuple]:
    h = int(h)
    m = int(m or 0)
    if m > 59:
        return None
    if ap:
        if not 1 <= h <= 12:
            return None
        return (h % 12 + (12 if ap == "pm" else 0), m)
    if h > 23:
        return None
    if part in ("noche", "night"):
        h = 0 if h == 12 else (h + 12 if 6 <= h < 12 else h)
    elif part in ("tarde", "afternoon", "evening"):
        h = h + 12 if h < 12 else h
    elif part == "madrugada":
        h = 0 if h == 12 else h
    elif part is None and pm_guess and 1 <= h <= 6:
        h += 12            # «a las 5» → 17:00 (heurística)
    return (h, m)


def find_recurrence(sc: Scratch):
    """→ (freq, interval, [weekdays]) o None."""
    if sc.take(RE_WEEKDAYS):
        return ("WEEKLY", 1, [0, 1, 2, 3, 4])
    for rx in RE_REC_WD:
        m = sc.take(rx)
        if m:
            days = sorted({WD[w] for w in re.findall(WD_ANY, m.group("days"))})
            interval = 2 if "other" in m.groupdict() and m.group("other") else 1
            return ("WEEKLY", interval, days)
    m = sc.take(RE_REC_UNIT)
    if m:
        if m.group("adv"):
            return (_ADV_FREQ[m.group("adv")], 1, [])
        n = m.group("n")
        interval = 1
        if n:
            interval = 2 if n in ("other", "otro", "otra") else int(n) if n.isdigit() else int(NUMW.get(n, 1))
        unit = m.group("unit").rstrip("s") if m.group("unit") != "meses" else "mes"
        return (_UNIT_FREQ[unit], max(1, interval), [])
    return None


def find_duration(sc: Scratch, prefixed: bool) -> Optional[int]:
    def mins(m):
        if m.group("half"):
            return 30
        if m.group("h"):
            t = num_val(m.group("h")) * 60
            if m.group("hh") is not None:
                t += 30
            elif m.group("hm"):
                t += int(m.group("hm"))
            elif m.group("hg"):
                t += int(m.group("hg"))
            return round(t)
        return round(num_val(m.group("m")))

    res = []

    def chk(m):
        v = mins(m)
        if v > 0:
            res.append(v)
            return True
        return False

    m = sc.take(RE_DUR_PREFIXED if prefixed else RE_DUR_BARE, chk)
    return res[0] if m else None


def find_time(sc: Scratch, pm_guess: bool):
    """→ ((h, m), (h, m) | None) o None."""
    res: list = []

    def chk_range(m):
        has_colon = bool(m.group("m1") or m.group("m2"))
        has_ap = bool(m.group("a1") or m.group("a2"))
        pre, conn = m.group("pre"), m.group("conn")
        if conn in ("y", "and") and pre not in ("entre", "between"):
            return False
        if not (pre or (has_colon or has_ap)):
            return False
        if not pre and not ((m.group("m1") or m.group("a1")) and (m.group("m2") or m.group("a2"))):
            return False
        a1, a2 = m.group("a1"), m.group("a2")
        if a2 and not a1:
            a1 = a2 if int(m.group("h1")) <= int(m.group("h2")) else ("am" if a2 == "pm" else "pm")
        s = to_hm(m.group("h1"), m.group("m1"), a1, None, pm_guess)
        e = to_hm(m.group("h2"), m.group("m2"), a2, None, pm_guess)
        if s is None or e is None:
            return False
        res.append((s, e))
        return True

    if sc.take(RE_T_RANGE, chk_range):
        return res[0]

    for rx in (RE_T1, RE_T2, RE_T3):
        res = []

        def chk(m):
            g = m.groupdict()
            v = to_hm(g["h"], g.get("m"), g.get("a"), g.get("part"), pm_guess)
            if v is None:
                return False
            res.append(v)
            return True

        if sc.take(rx, chk):
            return (res[0], None)

    m = sc.take(RE_T4)
    if m:
        return (((0, 0) if m.group("w") in ("medianoche", "midnight") else (12, 0)), None)
    return None


def find_date(sc: Scratch, today: dt.date, order: str):
    """→ ('date', d) | ('weekday', wd, strict_next) | None"""
    res: list = []

    def attempt(rx, build):
        res.clear()

        def chk(m):
            d = build(m)
            if d is None:
                return False
            res.append(d)
            return True

        return sc.take(rx, chk)

    if attempt(RE_ISO, lambda m: mk_date(m["y"], int(m["mo"]), int(m["d"]), today)):
        return ("date", res[0])
    if attempt(RE_D1, lambda m: mk_date(m["y"], MONTHS[m["mon"]], int(m["d"]), today)):
        return ("date", res[0])
    if attempt(RE_D2, lambda m: mk_date(m["y"], MONTHS[m["mon"]], int(m["d"]), today)):
        return ("date", res[0])
    if attempt(RE_NUM_Y4, lambda m: mk_date(m["y"], *((int(m["b"]), int(m["a"])) if order == "dmy"
                                                       else (int(m["a"]), int(m["b"]))), today)):
        return ("date", res[0])
    if attempt(RE_NUM, lambda m: mk_date(m["y"], *((int(m["b"]), int(m["a"])) if order == "dmy"
                                                    else (int(m["a"]), int(m["b"]))), today)):
        return ("date", res[0])

    if sc.take(RE_AFTER_TOMORROW):
        return ("date", today + dt.timedelta(days=2))
    if sc.take(RE_TOMORROW):
        return ("date", today + dt.timedelta(days=1))
    if sc.take(RE_TODAY):
        return ("date", today)
    m = sc.take(RE_IN_N)
    if m:
        n = int(num_val(m.group("n")))
        u = m.group("u")
        if u.startswith(("dia", "day")):
            return ("date", today + dt.timedelta(days=n))
        if u.startswith(("sem", "week")):
            return ("date", today + dt.timedelta(weeks=n))
        return ("date", add_months(today, n))
    if sc.take(RE_NEXT_WEEK):
        return ("date", today + dt.timedelta(days=7))
    m = sc.take(RE_WEEKDAY)
    if m:
        strict = bool(re.search(r"proximo|next", m.group("pre")))
        return ("weekday", WD[m.group("wd")], strict)
    return None


def parse(text: str, now: dt.datetime, date_order: str = "dmy",
          default_minutes: int = 60, pm_guess: bool = True) -> Event:
    text = unicodedata.normalize("NFC", text).strip()
    if not text:
        raise ParseError("frase vacía")
    sc = Scratch(text)
    today = now.date()
    tz = now.tzinfo

    rec = find_recurrence(sc)
    dur = find_duration(sc, prefixed=True)
    tm = find_time(sc, pm_guess)
    if dur is None:
        dur = find_duration(sc, prefixed=False)
    when = find_date(sc, today, date_order)
    if when is None or when[0] == "date":      # quita «el martes» aunque ya haya fecha explícita
        pass
    if when and when[0] == "date":
        sc.take(RE_WEEKDAY)

    def passed(d: dt.date, hm) -> bool:
        return dt.datetime.combine(d, dt.time(*hm), tz) <= now

    start_hm = tm[0] if tm else None
    byday = rec[2] if rec else []

    if when is None:
        if rec:
            d = today + dt.timedelta(days=1) if (start_hm and passed(today, start_hm)) else today
            while byday and d.weekday() not in byday:
                d += dt.timedelta(days=1)
        elif start_hm:
            d = today + dt.timedelta(days=1) if passed(today, start_hm) else today
        else:
            raise ParseError("no encontré fecha ni hora")
    elif when[0] == "weekday":
        delta = (when[1] - today.weekday()) % 7
        if delta == 0 and (when[2] or (start_hm and passed(today, start_hm))):
            delta = 7
        d = today + dt.timedelta(days=delta)
    else:
        d = when[1]
        while byday and d.weekday() not in byday:
            d += dt.timedelta(days=1)

    title = sc.title() or "Evento"

    rrule = recur_text = None
    if rec:
        freq, interval, days = rec
        parts = [f"FREQ={freq}"]
        if interval > 1:
            parts.append(f"INTERVAL={interval}")
        if days:
            parts.append("BYDAY=" + ",".join(ICS_DAYS[x] for x in days))
        rrule = ";".join(parts)
        recur_text = recur_description(freq, interval, days)

    if start_hm is None:
        return Event(title, d, d + dt.timedelta(days=1), True, rrule, recur_text)

    start = dt.datetime.combine(d, dt.time(*start_hm), tz)
    if tm[1] is not None:
        end = dt.datetime.combine(d, dt.time(*tm[1]), tz)
        if end <= start:
            end = end + dt.timedelta(hours=12) if tm[1][0] < 12 and (end + dt.timedelta(hours=12)) > start \
                else end + dt.timedelta(days=1)
    else:
        end = start + dt.timedelta(minutes=dur or default_minutes)
    return Event(title, start, end, False, rrule, recur_text)


def recur_description(freq: str, interval: int, days: list) -> str:
    if freq == "WEEKLY" and days:
        if days == [0, 1, 2, 3, 4]:
            base = "de lunes a viernes"
        else:
            names = [DAY_NAMES[x] for x in days]
            base = "cada " + (names[0] if len(names) == 1 else ", ".join(names[:-1]) + " y " + names[-1])
        return base + (f" (cada {interval} semanas)" if interval > 1 else "")
    one, plural = {"DAILY": ("todos los días", "días"), "WEEKLY": ("cada semana", "semanas"),
                   "MONTHLY": ("cada mes", "meses"), "YEARLY": ("cada año", "años")}[freq]
    return one if interval == 1 else f"cada {interval} {plural}"


# ════════════════════════════════════════════════════════════════════════════
#  iCalendar
# ════════════════════════════════════════════════════════════════════════════

def _esc(t: str) -> str:
    return t.replace("\\", "\\\\").replace(";", "\\;").replace(",", "\\,").replace("\n", "\\n")


def _fold(line: str) -> str:
    if len(line.encode()) <= 75:
        return line
    out, cur = [], ""
    for ch in line:
        limit = 75 if not out else 74
        if len((cur + ch).encode()) > limit:
            out.append(cur)
            cur = ch
        else:
            cur += ch
    out.append(cur)
    return "\r\n ".join(out)


def to_ics(ev: Event, tzname: str, now: dt.datetime) -> str:
    utc = dt.timezone.utc
    f_local = "%Y%m%dT%H%M%S"
    L = ["BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//saywhen-cli//ES", "CALSCALE:GREGORIAN",
         "BEGIN:VEVENT", f"UID:{ev.uid}", "DTSTAMP:" + now.astimezone(utc).strftime("%Y%m%dT%H%M%SZ")]
    if ev.all_day:
        L += [f"DTSTART;VALUE=DATE:{ev.start:%Y%m%d}", f"DTEND;VALUE=DATE:{ev.end:%Y%m%d}"]
    elif ev.rrule:      # recurrente: hora local con TZID para respetar el horario de verano
        L += [f"DTSTART;TZID={tzname}:{ev.start.strftime(f_local)}",
              f"DTEND;TZID={tzname}:{ev.end.strftime(f_local)}"]
    else:
        L += ["DTSTART:" + ev.start.astimezone(utc).strftime("%Y%m%dT%H%M%SZ"),
              "DTEND:" + ev.end.astimezone(utc).strftime("%Y%m%dT%H%M%SZ")]
    if ev.rrule:
        L.append(f"RRULE:{ev.rrule}")
    L += [f"SUMMARY:{_esc(ev.title)}", "END:VEVENT", "END:VCALENDAR"]
    return "\r\n".join(_fold(x) for x in L) + "\r\n"


# ════════════════════════════════════════════════════════════════════════════
#  Presentación
# ════════════════════════════════════════════════════════════════════════════

def _fmt_day(d) -> str:
    return f"{DOW_SHORT[d.weekday()]} {d.day} {MON_SHORT[d.month - 1]} {d.year}"


def when_text(ev: Event) -> str:
    if ev.all_day:
        return f"{_fmt_day(ev.start)} (todo el día)"
    if ev.start.date() == ev.end.date():
        return f"{_fmt_day(ev.start)}, {ev.start:%H:%M}–{ev.end:%H:%M}"
    return f"{_fmt_day(ev.start)} {ev.start:%H:%M} → {_fmt_day(ev.end)} {ev.end:%H:%M}"


def one_line(ev: Event) -> str:
    s = f"{ev.title} · {when_text(ev)}"
    return s + (f" · {ev.recur_text}" if ev.recur_text else "")


def preview(ev: Event, cfg: "Config") -> str:
    rows = [("Título", ev.title), ("Cuándo", when_text(ev))]
    if ev.recur_text:
        rows.append(("Repite", ev.recur_text))
    if cfg.url:
        rows.append(("Calendario", cfg.url))
    return "\n".join(f"  {k + ':':<12}{v}" for k, v in rows)


# ════════════════════════════════════════════════════════════════════════════
#  Configuración
# ════════════════════════════════════════════════════════════════════════════

def config_path(override: Optional[str] = None) -> Path:
    if override:
        return Path(override).expanduser()
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / "saywhen" / "config.ini"


def detect_tz(name: Optional[str] = None) -> str:
    cands = [name, os.environ.get("TZ")]
    try:
        link = os.path.realpath("/etc/localtime")
        if "/zoneinfo/" in link:
            cands.append(link.split("/zoneinfo/", 1)[1])
    except OSError:
        pass
    try:
        cands.append(Path("/etc/timezone").read_text().strip())
    except OSError:
        pass
    for c in cands:
        if c:
            try:
                ZoneInfo(c.lstrip(":"))
                return c.lstrip(":")
            except (ZoneInfoNotFoundError, ValueError):
                continue
    return "UTC"


@dataclass
class Config:
    url: str = ""
    username: str = ""
    password: str = ""
    password_cmd: str = ""
    tzname: str = "UTC"
    verify_tls: bool = True
    date_order: str = "dmy"
    default_minutes: int = 60
    pm_guess: bool = True

    @property
    def tz(self) -> ZoneInfo:
        return ZoneInfo(self.tzname)

    def now(self) -> dt.datetime:
        return dt.datetime.now(self.tz)

    def get_password(self) -> str:
        if os.environ.get("SAYWHEN_PASSWORD"):
            return os.environ["SAYWHEN_PASSWORD"]
        if self.password_cmd:
            r = subprocess.run(self.password_cmd, shell=True, capture_output=True, text=True)
            if r.returncode != 0:
                raise SystemExit(f"password_cmd falló: {r.stderr.strip() or r.returncode}")
            return r.stdout.strip().split("\n")[0]
        return self.password


def load_config(path: Path) -> Config:
    cp = configparser.ConfigParser()
    if path.exists():
        cp.read(path, encoding="utf-8")
    g = cp["radicale"] if cp.has_section("radicale") else {}
    cfg = Config(
        url=g.get("url", ""), username=g.get("username", ""), password=g.get("password", ""),
        password_cmd=g.get("password_cmd", ""), tzname=detect_tz(g.get("timezone") or None),
        verify_tls=str(g.get("verify_tls", "true")).lower() not in ("0", "false", "no"),
        date_order=g.get("date_order", "dmy").lower(),
        default_minutes=int(g.get("default_duration", 60)),
        pm_guess=str(g.get("pm_guess", "true")).lower() not in ("0", "false", "no"),
    )
    cfg.url = os.environ.get("SAYWHEN_URL", cfg.url)
    cfg.username = os.environ.get("SAYWHEN_USER", cfg.username)
    if cfg.url and not cfg.url.endswith("/"):
        cfg.url += "/"
    return cfg


# ════════════════════════════════════════════════════════════════════════════
#  CalDAV (Radicale)
# ════════════════════════════════════════════════════════════════════════════

def _request(cfg: Config, method: str, url: str, body: Optional[bytes] = None, headers=None):
    token = base64.b64encode(f"{cfg.username}:{cfg.get_password()}".encode()).decode()
    req = urllib.request.Request(url, data=body, method=method)
    req.add_header("Authorization", f"Basic {token}")
    for k, v in (headers or {}).items():
        req.add_header(k, v)
    ctx = ssl.create_default_context()
    if not cfg.verify_tls:
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    return urllib.request.urlopen(req, timeout=15, context=ctx)


def _need_server(cfg: Config):
    if not cfg.url:
        raise SystemExit("Falta la URL del calendario. Ejecuta `saywhen --init` o define SAYWHEN_URL.")


def _explain_http(e: urllib.error.HTTPError) -> str:
    hints = {401: "usuario o contraseña incorrectos", 403: "ese usuario no tiene permiso sobre este calendario",
             404: "la URL del calendario no existe (revisa usuario y nombre de la colección)",
             409: "la colección no existe (¿URL mal escrita o calendario sin crear?)",
             412: "ya existe un evento con ese UID", 405: "la URL no parece una colección de calendario"}
    return f"HTTP {e.code} — {hints.get(e.code, e.reason)}"


def put_event(cfg: Config, ev: Event, ics: str):
    _need_server(cfg)
    try:
        with _request(cfg, "PUT", f"{cfg.url}{ev.uid.split('@')[0]}.ics", ics.encode("utf-8"),
                      {"Content-Type": "text/calendar; charset=utf-8", "If-None-Match": "*"}) as r:
            return r.status
    except urllib.error.HTTPError as e:
        raise SystemExit(f"Radicale rechazó el evento: {_explain_http(e)}")
    except (urllib.error.URLError, OSError) as e:
        raise SystemExit(f"No se pudo conectar con {cfg.url}: {getattr(e, 'reason', e)}")


def check_connection(cfg: Config) -> bool:
    _need_server(cfg)
    body = (b'<?xml version="1.0"?><propfind xmlns="DAV:"><prop><resourcetype/></prop></propfind>')
    try:
        with _request(cfg, "PROPFIND", cfg.url, body,
                      {"Depth": "0", "Content-Type": "application/xml"}) as r:
            text = r.read().decode("utf-8", "replace").lower()
    except urllib.error.HTTPError as e:
        print(f"✗ {_explain_http(e)}")
        return False
    except (urllib.error.URLError, OSError) as e:
        print(f"✗ No se pudo conectar: {getattr(e, 'reason', e)}")
        return False
    if "calendar" in text:
        print("✓ Conexión correcta: es una colección de calendario.")
        return True
    print("! El servidor responde, pero esa URL no parece una colección de calendario.")
    return False


def run_init(path: Path) -> Config:
    print(f"Configuración → {path}\n")
    print("La URL es la de la colección de calendario, p. ej. https://radicale.ejemplo.com/usuario/calendario/")
    url = input("URL del calendario: ").strip()
    user = input("Usuario: ").strip()
    pw = getpass.getpass("Contraseña (vacío = no guardarla; usa password_cmd o SAYWHEN_PASSWORD): ")
    tz = input(f"Zona horaria [{detect_tz()}]: ").strip() or detect_tz()
    lines = ["[radicale]", f"url = {url}", f"username = {user}"]
    lines.append(f"password = {pw}" if pw else "# password_cmd = pass show radicale")
    lines += [f"timezone = {tz}", "# verify_tls = true", "# date_order = dmy   ; o mdy",
              "# default_duration = 60", "# pm_guess = true    ; «a las 5» → 17:00"]
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    path.chmod(0o600)
    print("Guardado.\n")
    cfg = load_config(path)
    if not pw and not cfg.password_cmd:
        cfg.password = getpass.getpass("Contraseña para probar la conexión: ")
        os.environ["SAYWHEN_PASSWORD"] = cfg.password
    check_connection(cfg)
    return cfg


