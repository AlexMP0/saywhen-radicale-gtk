_ACCENTS = str.maketrans("áéíóúüñ", "aeiouun")


def norm(text: str) -> str:
    """Minúsculas y sin acentos, conservando la longitud (1 carácter → 1 carácter)."""
    return "".join(c.lower()[:1] for c in text).translate(_ACCENTS)


def _alt(words) -> str:
    return "(?:" + "|".join(sorted(words, key=len, reverse=True)) + ")"


_WD_BASE = {
    "lunes": 0, "martes": 1, "miercoles": 2, "jueves": 3, "viernes": 4,
    "sabado": 5, "domingo": 6,
    "monday": 0, "tuesday": 1, "wednesday": 2, "thursday": 3, "friday": 4,
    "saturday": 5, "sunday": 6,
}
WD = dict(_WD_BASE)
WD.update({k + "s": v for k, v in _WD_BASE.items() if not k.endswith("s")})
WD_ANY = _alt(WD)                    # con plurales (sábados, mondays…)
WD_SING = _alt(_WD_BASE)
WD_PL_EN = _alt([k + "s" for k in _WD_BASE if k.endswith("day")])

MONTHS: dict[str, int] = {}
for _i, _names in enumerate([
