}
NUM = r"(?:\d+(?:[.,]\d+)?|" + "|".join(sorted(NUMW, key=len, reverse=True)) + r")"

PART = r"(?:manana|tarde|noche|madrugada|morning|afternoon|evening|night)"

DAY_NAMES = ["lunes", "martes", "miércoles", "jueves", "viernes", "sábado", "domingo"]
DOW_SHORT = ["lun", "mar", "mié", "jue", "vie", "sáb", "dom"]
